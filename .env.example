# ─────────────────────────────────────────────────────────────
# 30praum — environment template
# Copie para .env.local e preencha. Nunca commite .env.local.
# ─────────────────────────────────────────────────────────────

# Pública: URL base do site (usada em metadata + sitemap)
NEXT_PUBLIC_SITE_URL=https://merch30praum.vercel.app

# Pública: URL pública do servidor (usada pelo Payload pra links absolutos)
NEXT_PUBLIC_SERVER_URL=https://merch30praum.vercel.app

# ─────────────────────────────────────────────────────────────
# Supabase Postgres (Payload CMS)
# ─────────────────────────────────────────────────────────────
# Connection string da role postgres do projeto Supabase.
# Use ?sslmode=no-verify pra contornar self-signed cert no driver pg.
DATABASE_URI=

# Secret do Payload — gere com: openssl rand -hex 32
PAYLOAD_SECRET=

# ─────────────────────────────────────────────────────────────
# Shopify Storefront API. Com os dois preenchidos o site sai do modo mock:
# catálogo com preço e estoque reais, carrinho na Shopify e checkout oficial.
# Obter em: Admin Shopify → instalar o canal de vendas "Headless" → criar
# storefront → copiar o token PÚBLICO. O domínio é o .myshopify.com da loja,
# não o 30praum.store.
# ─────────────────────────────────────────────────────────────
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
# Assinatura dos webhooks da Shopify (Configurações → Notificações → Webhooks,
# aparece abaixo da lista). Webhooks de produto e estoque apontam para
# https://<site>/api/shopify/webhook
SHOPIFY_WEBHOOK_SECRET=

# Segredo de /api/revalidate (Payload → invalida cache).
# Gerar com: openssl rand -hex 32
REVALIDATE_SECRET=change-me

# Login do fã (conta de cliente da Shopify, canal Headless > Customer Account API).
# Callback: https://SEU-DOMINIO/api/auth/shopify/callback  Logout: https://SEU-DOMINIO/
SHOPIFY_CUSTOMER_ACCOUNT_DOMAIN=
SHOPIFY_CUSTOMER_CLIENT_ID=
SHOPIFY_CUSTOMER_CLIENT_SECRET=
